{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creator Nexus",
  "version": "0.1.0",
  "identifier": "ai.creatornexus.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Creator Nexus",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Productivity",
    "shortDescription": "Human-in-the-loop AI content creation studio",
    "longDescription": "A semi-automatic creator workflow studio with approval gates, provider routing and media pipelines."
  }
}
